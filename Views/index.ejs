<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>MY APP</title>
</head>
<body>
<div>
<!-- header information -->
<h2>Replace last quote written by Elizabeth with a quote written by Htebazile</h2>

<button id="update" data-id="<%= crud.length ? crud[crud.length-1]._id : '' %>"> Rolling my eyes like a spinning fruit machine </button>
<!-- message on button -->
</div>

  May Node, Express, MongoDB, NODEMON and EmbeddedJS be with you.

<ul class="crud">
  <% for(var i=0; i<crud.length; i++) {%>
    <li class="quote">
      <span><%= crud[i].name %></span>
      <span><%= crud[i].quote %></span>
    </li>
  <% } %>
</ul>

  <form action="/quotes" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" placeholder="name" name="name">
    <input type="text" placeholder="quote" name="quote">
    <button type="submit">Submit</button>
  </form>

<!-- ... -->
<script src="main.js"></script>
</body>
</html>